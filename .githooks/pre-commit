#!/usr/bin/env node
// Garde-fou de commit, commun aux deux agents — voir
// spec/outillage/spec.md, ex-B.9 (niveaux d'application, installation).
//
// ⚠️ **Pourquoi un hook GIT et pas un hook d'agent.** Un `PreToolUse` de Claude
// Code ne vaut que pour Claude Code. Codex a **aussi** un système de hooks
// (`SessionStart`, `PreToolUse`, `Stop`) — l'affirmation contraire, écrite ici
// dans une première version, était fausse — mais ce sont deux dispositifs
// distincts, à configurer et à maintenir séparément. Le seul point que les deux
// agents traversent sans configuration commune, quel que soit le CLI, reste
// `git commit`. Des hooks d'agent VIENDRAIENT EN PLUS de celui-ci, pas à sa
// place : eux contrôlent au moment de l'action, lui au moment du commit.
//
// ⚠️ **Portée volontairement ÉTROITE, et ce n'est pas une exclusion mutuelle.**
// Ce hook n'empêche pas d'éditer, seulement de committer ; il se contourne
// (`--no-verify`) ; il ne remplace jamais l'étape d'intégration. Il attrape
// l'erreur ORDINAIRE, celle qu'on fait en pensant à autre chose.
//
// ⚠️ **Il n'est JAMAIS requis.** Son câblage est une config de machine
// (`core.hooksPath`), posée par `npm install` (script `prepare`) : un clone
// sans dépendances installées développe, teste et commite normalement.
//
// ⚠️ **Le script SOURCE est ici ; ce qui s'exécute est son INSTALLATION** (hors
// arbre de travail, sous le répertoire git commun). Sans quoi son contenu
// dépendrait de la branche checkoutée. `node scripts/installer-hooks.mjs`
// fait la copie.

import { execFileSync } from 'child_process';
import { existsSync, readFileSync } from 'fs';
import { dirname, join, posix, resolve } from 'path';
import { fileURLToPath } from 'url';

const ROUGE = '\x1b[31m';
const JAUNE = '\x1b[33m';
const FIN = '\x1b[0m';

// Un fichier plus gros que ça n'est pas du code. Le plus gros fichier
// légitime du dépôt est `public/data/monsters.json` (2,2 Mo) — plus du double
// de marge. Un export de compte SW pèse ~9,5 Mo : c'est la cible.
const TAILLE_MAX = 5 * 1024 * 1024;

const CHEMINS_PRIVES = [
  { motif: /(^|\/)\.history\//, quoi: 'révisions locales de l’éditeur' },
  { motif: /(^|\/)\.vscode\//, quoi: 'réglages VS Code propres à la machine' },
];

// Sous `spec/outils/optimizer/` (AVEC la barre finale : `optimizer.md` est
// une autre spec), un fichier n'entre que s'il est nommé dans
// `.githooks/optimizer-publics.txt`, lue dans l'INDEX — un fichier publié et
// sa ligne vont dans le même commit ; liste absente = vide —, et si son
// contenu ne porte aucune marque de note privée : renvoi vers les
// sous-dossiers de notes de ce dossier, renvoi vers `a-publier/` où qu'il
// soit, identifiant de lot.
// ⚠️ Un ancien outillage peut encore recopier des notes privées dans ce
// dossier, sous le nom d'un fichier publié : la liste seule ne suffit pas.
// Limite assumée : une note privée sans aucune de ces marques passe.
const DOSSIER_OPTIMIZER = 'spec/outils/optimizer/';
const LISTE_PUBLICS = '.githooks/optimizer-publics.txt';
// Un dossier de notes, ou ce qu'il contient ; `(\/|$)` couvre le lien vers
// le dossier lui-même.
const NOTES_SOUS_OPTIMIZER = /(^|\/)spec\/outils\/optimizer\/(archive|chantiers|decisions)(\/|$)/i;
const SEGMENT_NOTES = /(^|\/)(archive|chantiers|decisions|a-publier)(\/|$)/i;
const SEGMENT_A_PUBLIER = /(^|\/)a-publier(\/|$)/i;
const DELIMITEURS = /[\s()[\]<>`'"|,;:=*«»]+/;
// Destination d'un lien en ligne, ou d'une définition de lien par
// référence (`[nom]: cible`). Un lien éclaté sur plusieurs lignes n'est pas lu.
const LIEN = /\]\(\s*<?([^)\s>]+)/g;
const DEFINITION_LIEN = /^\s{0,3}\[[^\]]+\]:\s*<?([^\s>]+)/;
// Identifiant de lot : le mot « lot » ou « lots » (toute casse usuelle, pas
// « slot », « pilote » ni « îlot »), au plus deux espaces (insécables
// comprises) ou tirets, puis un numéro (lettre, « bis » ou plage en
// suffixe), une étiquette lettres et chiffres, ou une étiquette CM/EX ; ou
// la clé de données `lot:` suivie d'un numéro entre guillemets. Le mot seul
// (« un lot de runes ») ne correspond pas.
const MOTIF_LOT = /(?<![\p{L}\p{N}_])(?:[Ll]ots?|LOTS?)[\t \u00A0\u202F-]{0,2}(?:[0-9]+(?:[a-z][0-9]?)?(?:bis|[-–][0-9a-z]+)?|[A-Z]{1,2}[0-9]+[a-z0-9]*|CM\b|EX[0-9]?\b)|(?<![\p{L}\p{N}_])lot: ?['"][0-9][0-9a-z]*['"]/u;

function git(...args) {
  return execFileSync('git', args, { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 }).trim();
}

const refus = [];
const avertissements = [];

// `--commit <sha>` : la CI rejoue les refus 2 et 3 sur un commit déjà fait,
// dont le contenu tient lieu d'index (`scripts/verifier-commits.mjs`). La
// branche, spec-lint et ESLint n'y tournent pas : la CI vérifie l'état final
// par `npm test` et `npm run lint`.
const iCommit = process.argv.indexOf('--commit');
const COMMIT = iCommit > 1 ? process.argv[iCommit + 1] : null;
// Préfixe d'objet Git : `:<chemin>` lit l'index, `<sha>:<chemin>` le commit.
const OBJET = COMMIT ? `${COMMIT}:` : ':';

/* ---------------------------------------------------- 1. jamais sur `main` */

let branche = '';
try {
  branche = git('rev-parse', '--abbrev-ref', 'HEAD');
} catch {
  // Dépôt sans commit : rien à protéger, on laisse passer.
  process.exit(0);
}

if (COMMIT) {
  // Commit déjà fait : la branche où il a été écrit ne se juge plus.
} else if (branche === 'main' || branche === 'master') {
  refus.push({
    titre: `commit direct sur ${branche}`,
    details: [
      'Trois incidents déjà. Le travail se fait sur une branche `forge/<sujet>`,',
      'et `main` ne reçoit que des fusions décidées explicitement.',
      '',
      'Créer une branche sans rien perdre :',
      '  git checkout -b forge/<sujet>',
    ],
  });
} else if (!/^forge\//.test(branche)) {
  // Les branches `feat/…` et `release/…` existent dans l'historique : on
  // signale la convention, on ne bloque pas un travail légitime.
  avertissements.push(
    `branche « ${branche} » hors convention — le dépôt nomme ses chantiers ` +
      '`forge/<sujet>` (CLAUDE.md).'
  );
}

/* -------------------------------------- 2. aucun chemin privé dans l'index */

// `-z` : sans lui, Git cite un chemin non ASCII entre guillemets, avec ses
// octets échappés, et aucun motif ancré ne le reconnaît plus.
let stagés = [];
try {
  stagés = (COMMIT
    // `--root` : un premier commit se compare à l'arbre vide.
    ? git('diff-tree', '--root', '-r', '--no-commit-id', '--name-only', '-z', '--diff-filter=ACMR', COMMIT)
    : git('diff', '--cached', '--name-only', '-z', '--diff-filter=ACMR')
  ).split('\0').filter(Boolean);
} catch {
  process.exit(0);
}

for (const chemin of stagés) {
  for (const { motif, quoi } of CHEMINS_PRIVES) {
    if (motif.test(chemin)) {
      refus.push({
        titre: `chemin privé dans l’index : ${chemin}`,
        details: [
          `Nature : ${quoi}.`,
          '',
          'Ces fichiers sont gitignorés : ils sont propres à la machine. Les',
          'committer les enverrait vers un dépôt PUBLIC.',
          '',
          `  git restore --staged "${chemin}"`,
        ],
      });
    }
  }
}

/* ------------------- 2 bis. sous spec/outils/optimizer/, le publié seul */

// Version de l'index, jamais l'arbre de travail : c'est elle qui part.
function lireIndex(chemin) {
  try {
    return execFileSync('git', ['show', `${OBJET}${chemin}`],
      { maxBuffer: 64 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'] });
  } catch {
    return null;
  }
}

// UTF-16 à BOM décodé comme tel, sinon UTF-8 sans NUL (UTF-16 sans BOM) ;
// puis NFC, pour qu'un caractère composé ou décomposé se lise pareil.
function texte(octets) {
  const corps = octets.subarray(2, 2 + ((octets.length - 2) & ~1));
  if (octets[0] === 0xff && octets[1] === 0xfe) return corps.toString('utf16le').normalize('NFC');
  if (octets[0] === 0xfe && octets[1] === 0xff) return Buffer.from(corps).swap16().toString('utf16le').normalize('NFC');
  return octets.toString('utf8').replace(/\0/g, '').normalize('NFC');
}

// Un renvoi qui aboutit dans les sous-dossiers de notes, après
// normalisation, résolu depuis la racine (forme `spec/…`, ou adresse qui
// contient ce chemin) ou depuis le dossier du fichier (forme relative) ; un
// `a-publier` est refusé où qu'il soit. Un renvoi public homonyme
// (`spec/chantiers/…`, `../degats-reels/decisions/…`) passe. Hors d'une
// destination de lien, un jeton sans `/` est un mot, pas un renvoi.
function renvoiAuxNotes(fichier, jeton, lien = false) {
  const chemin = jeton.replace(/\\/g, '/').replace(/[#?].*$/, '');
  if (!lien && !chemin.includes('/')) return false;
  if (!SEGMENT_NOTES.test(chemin)) return false;
  if (SEGMENT_A_PUBLIER.test(chemin)) return true;
  if (NOTES_SOUS_OPTIMIZER.test(posix.normalize(chemin))) return true;
  if (/^spec\//i.test(chemin)) return false;
  return NOTES_SOUS_OPTIMIZER.test(posix.normalize(posix.join(posix.dirname(fichier), chemin)));
}

// Casse ignorée pour la détection, exacte pour la liste : un `Optimizer/`
// se confond avec le dossier sur un disque Windows.
const optimizer = stagés.filter((c) => c.toLowerCase().startsWith(DOSSIER_OPTIMIZER));
if (optimizer.length > 0) {
  const publies = new Set((lireIndex(LISTE_PUBLICS)?.toString('utf8') ?? '').split(/\r?\n/)
    .map((l) => l.trim()).filter((l) => l && !l.startsWith('#')));
  for (const chemin of optimizer) {
    if (!publies.has(chemin)) {
      refus.push({
        titre: `fichier non publié sous ${DOSSIER_OPTIMIZER} : ${chemin}`,
        details: [
          `Seuls les fichiers nommés dans ${LISTE_PUBLICS} (version de l’index) y entrent.`,
          'Fichier publié volontairement : ajouter sa ligne à la liste, dans le même commit.',
          'Sinon :',
          `  git restore --staged "${chemin}"`,
        ],
      });
      continue;
    }
    const contenu = lireIndex(chemin);
    if (contenu === null) {
      refus.push({
        titre: `contenu illisible dans l’index : ${chemin}`,
        details: ['Son contenu ne se vérifie pas : il ne part pas.', `  git restore --staged "${chemin}"`],
      });
      continue;
    }
    const marques = [];
    texte(contenu).split(/\r?\n/).forEach((ligne, i) => {
      const liens = [...ligne.matchAll(LIEN)].map((m) => m[1]);
      const definition = ligne.match(DEFINITION_LIEN);
      if (definition) liens.push(definition[1]);
      if (ligne.split(DELIMITEURS).some((jeton) => renvoiAuxNotes(chemin, jeton))
        || liens.some((cible) => renvoiAuxNotes(chemin, cible, true))) {
        marques.push(`l. ${i + 1}, renvoi aux notes : ${ligne.trim()}`);
      }
      if (MOTIF_LOT.test(ligne)) marques.push(`l. ${i + 1}, identifiant de lot : ${ligne.trim()}`);
    });
    if (marques.length > 0) {
      refus.push({
        titre: `marque de note privée dans ${chemin}`,
        details: [
          ...marques.slice(0, 10),
          ...(marques.length > 10 ? [`… (+${marques.length - 10})`] : []),
          '',
          'Une spec publiée ne renvoie pas aux notes et ne porte pas d’identifiant de lot.',
          'Un mot suivi d’une barre (« archive/… ») se lit comme un renvoi : le reformuler',
          's’il n’en est pas un. Si ce contenu est une copie de note privée :',
          `  git restore --staged "${chemin}"`,
        ],
      });
    }
  }
}

/* ------------------------------------------- 3. aucun fichier démesuré */

for (const chemin of stagés) {
  let taille = 0;
  try {
    taille = Number(git('cat-file', '-s', `${OBJET}${chemin}`));
  } catch {
    continue;
  }
  if (taille > TAILLE_MAX) {
    refus.push({
      titre: `fichier de ${(taille / 1024 / 1024).toFixed(1)} Mo dans l’index : ${chemin}`,
      details: [
        `Au-delà de ${TAILLE_MAX / 1024 / 1024} Mo, ce n'est pas du code.`,
        "Un export de compte SW pèse ~9,5 Mo et n'a rien à faire dans le dépôt.",
        '',
        `  git restore --staged "${chemin}"`,
        '',
        'Si ce fichier est légitime, ce hook se contourne : `git commit --no-verify`.',
      ],
    });
  }
}

/* ------------------------------------------ 4. spec-lint sur l'INDEX */
//
// ⚠️ Le périmètre a une seule source de vérité, `spec/spec-lint.json`, et
// c'est `verifier()` qui l'applique — ce hook ne fait que lui SOUMETTRE les
// `spec/**.md` de l'index et NE GARDER que les erreurs qui les concernent :
// un fichier hors périmètre (`verifier` ne le voit tout simplement pas) coûte
// zéro et n'est jamais refusé. Voir spec/outillage/spec.md, ex-B.9.

const specsIndex = stagés.filter((c) => /^spec\/.*\.md$/.test(c));

if (!COMMIT && specsIndex.length > 0) {
  const racineDepot = git('rev-parse', '--show-toplevel');
  const cheminConfig = join(racineDepot, 'spec', 'spec-lint.json');
  if (existsSync(cheminConfig)) {
    // ⚠️ Import RELATIF à ce script : en installation, `spec-lint.mjs` et son
    // parseur (`lib/spec-markdown.mjs`) vivent à côté, sous
    // `<installation>/scripts/` — voir `installer-hooks.mjs`, `CHEMINS`.
    const { verifier } = await import(new URL('../scripts/spec-lint.mjs', import.meta.url));
    const config = JSON.parse(readFileSync(cheminConfig, 'utf8'));
    const { erreurs } = verifier(racineDepot, config);
    const enJeu = erreurs.filter((e) => specsIndex.includes(e.fichier));
    if (enJeu.length > 0) {
      refus.push({
        titre: `spec-lint refuse ${enJeu.length} point(s) sur les specs de l’index`,
        details: [
          ...enJeu.map((e) => `${e.fichier}${e.ligne ? `:${e.ligne}` : ''} [${e.regle}] ${e.message}`),
          '',
          'Revoir le fichier, puis relire le détail :',
          '  node scripts/spec-lint.mjs',
        ],
      });
    }
  }
}

/* --------------------------------------------- 5. ESLint sur le code indexé */
//
// Les ERREURS seules (`--quiet`) : un avertissement ne bloque pas un commit.
// ESLint du dépôt (`node_modules`), avec sa configuration : absent (clone
// sans `npm install`), le lint est sauté avec un avertissement — le hook
// n'est jamais requis. Contrat : spec/outillage/qualite-code.md.

const CODE = /\.(ts|tsx|js|mjs|cjs)$/;
const codeIndex = stagés.filter((c) => CODE.test(c));

if (!COMMIT && codeIndex.length > 0) {
  const racineDepot = git('rev-parse', '--show-toplevel');
  const eslint = join(racineDepot, 'node_modules', 'eslint', 'bin', 'eslint.js');
  if (!existsSync(join(racineDepot, 'eslint.config.js'))) {
    // Branche antérieure au lint : rien à appliquer.
  } else if (!existsSync(eslint)) {
    avertissements.push('ESLint absent (`npm install`) : lint du code indexé sauté.');
  } else {
    // Par paquets : une ligne de commande Windows plafonne à ~32 000 caractères.
    const sorties = [];
    for (let i = 0; i < codeIndex.length; i += 100) {
      try {
        execFileSync(process.execPath, [eslint, '--quiet', '--no-warn-ignored', ...codeIndex.slice(i, i + 100)], {
          cwd: racineDepot,
          encoding: 'utf8',
          stdio: ['ignore', 'pipe', 'pipe'],
          maxBuffer: 64 * 1024 * 1024,
        });
      } catch (e) {
        sorties.push(((e.stdout ?? '') + (e.stderr ?? '')).trim());
      }
    }
    if (sorties.length > 0) {
      refus.push({
        titre: 'ESLint refuse le code indexé',
        details: [
          ...sorties.join('\n').split('\n'),
          '',
          'Corriger, réindexer, puis recommiter. Détail sur tout le dépôt :',
          '  npm run lint',
        ],
      });
    }
  }
}

/* ------------------------------------------------------------- verdict */

for (const a of avertissements) {
  console.error(`${JAUNE}⚠️  ${a}${FIN}`);
}

if (refus.length === 0) process.exit(0);

console.error('');
for (const { titre, details } of refus) {
  console.error(`${ROUGE}REFUSÉ — ${titre}${FIN}`);
  for (const d of details) console.error(`  ${d}`);
  console.error('');
}
process.exit(1);
