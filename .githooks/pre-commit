#!/usr/bin/env node
// Garde-fou de commit, commun à tous — humains et agents, quel que soit
// l'outil : `git commit` est le seul point que tous traversent. Voir
// docs/03-developpeur/qualite-code.md (niveaux d'application, installation).
//
// ⚠️ **Portée volontairement ÉTROITE, et ce n'est pas une exclusion mutuelle.**
// Ce hook n'empêche pas d'éditer, seulement de committer ; il se contourne
// (`--no-verify`), et la CI rejoue ses refus sur chaque commit d'une pull
// request (`scripts/verifier-commits.mjs`). Il attrape
// l'erreur ORDINAIRE, celle qu'on fait en pensant à autre chose.
//
// ⚠️ **Il n'est JAMAIS requis.** Son câblage est une config de machine
// (`core.hooksPath`), posée par `npm install` (script `prepare`) : un clone
// sans dépendances installées développe, teste et commite normalement.
//
// ⚠️ **Le script SOURCE est ici ; ce qui s'exécute est son INSTALLATION** (hors
// arbre de travail, sous le répertoire git commun). Sans quoi son contenu
// dépendrait de la branche checkoutée. `node scripts/installer-hooks.mjs`
// fait la copie.
//
// Refus, dans l'ordre : 1. commit sur `main` ; 2. chemin privé ; 3. fichier
// de plus de 5 Mo ; 4. erreur ESLint du code indexé ; 5. référence à `src/`
// non déclarée dans un test indexé. Les étapes 4 et 5 appliquent la règle de
// la BRANCHE (`eslint.config.js`, `scripts/lib/lectureSource.ts` et sa liste,
// pris dans le worktree et l'index) : c'est elle que le code doit respecter.

import { execFileSync } from 'child_process';
import { existsSync } from 'fs';
import { join } from 'path';
import { pathToFileURL } from 'url';

const ROUGE = '\x1b[31m';
const JAUNE = '\x1b[33m';
const FIN = '\x1b[0m';

// Un fichier plus gros que ça n'est pas du code. Le plus gros fichier
// légitime du dépôt est `public/data/monsters.json` (2,2 Mo) — plus du double
// de marge. Un export de compte SW pèse ~9,5 Mo : c'est la cible.
const TAILLE_MAX = 5 * 1024 * 1024;

// Une branche se nomme comme un commit : `<type>/<sujet>`, le type disant ce
// qu'elle va faire. Mêmes types que `.githooks/commit-msg`.
const TYPES_BRANCHE = ['feat', 'fix', 'docs', 'style', 'refactor', 'perf', 'test', 'build', 'ci', 'chore', 'revert'];
const BRANCHE = new RegExp(`^(${TYPES_BRANCHE.join('|')})/[^/\\s]+$`);

const CHEMINS_PRIVES = [
  { motif: /(^|\/)\.history\//, quoi: 'révisions locales de l’éditeur' },
  { motif: /(^|\/)\.vscode\//, quoi: 'réglages VS Code propres à la machine' },
];

function git(...args) {
  return execFileSync('git', args, { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 }).trim();
}

const refus = [];
const avertissements = [];

// `--commit <sha>` : la CI rejoue les refus 2 (chemin privé) et 3 (fichier
// démesuré) sur un commit déjà fait,
// dont le contenu tient lieu d'index (`scripts/verifier-commits.mjs`). La
// branche et ESLint n'y tournent pas : la CI vérifie l'état final
// par `npm test` et `npm run lint`.
const iCommit = process.argv.indexOf('--commit');
const COMMIT = iCommit > 1 ? process.argv[iCommit + 1] : null;
// Préfixe d'objet Git : `:<chemin>` lit l'index, `<sha>:<chemin>` le commit.
const OBJET = COMMIT ? `${COMMIT}:` : ':';

/* ---------------------------------------------------- 1. jamais sur `main` */

let branche = '';
try {
  branche = git('rev-parse', '--abbrev-ref', 'HEAD');
} catch {
  // Dépôt sans commit : rien à protéger, on laisse passer.
  process.exit(0);
}

if (COMMIT) {
  // Commit déjà fait : la branche où il a été écrit ne se juge plus.
} else if (branche === 'main' || branche === 'master') {
  refus.push({
    titre: `commit direct sur ${branche}`,
    details: [
      'Trois incidents déjà. Le travail se fait sur une branche `<type>/<sujet>`,',
      'et `main` ne reçoit que des fusions décidées explicitement.',
      '',
      'Créer une branche sans rien perdre :',
      '  git checkout -b feat/<sujet>',
    ],
  });
} else if (!BRANCHE.test(branche)) {
  // Les branches `forge/…` et `release/…` existent dans l'historique : on
  // signale la convention, on ne bloque pas un travail légitime.
  avertissements.push(
    `branche « ${branche} » hors convention — le dépôt nomme ses branches ` +
      `\`<type>/<sujet>\`, type comme un commit (${TYPES_BRANCHE.join(', ')}) — AGENTS.md.`
  );
}

/* -------------------------------------- 2. aucun chemin privé dans l'index */

// `-z` : sans lui, Git cite un chemin non ASCII entre guillemets, avec ses
// octets échappés, et aucun motif ancré ne le reconnaît plus.
let stagés = [];
try {
  stagés = (COMMIT
    // `--root` : un premier commit se compare à l'arbre vide.
    ? git('diff-tree', '--root', '-r', '--no-commit-id', '--name-only', '-z', '--diff-filter=ACMR', COMMIT)
    : git('diff', '--cached', '--name-only', '-z', '--diff-filter=ACMR')
  ).split('\0').filter(Boolean);
} catch {
  process.exit(0);
}

for (const chemin of stagés) {
  for (const { motif, quoi } of CHEMINS_PRIVES) {
    if (motif.test(chemin)) {
      refus.push({
        titre: `chemin privé dans l’index : ${chemin}`,
        details: [
          `Nature : ${quoi}.`,
          '',
          'Ces fichiers sont gitignorés : ils sont propres à la machine. Les',
          'committer les enverrait vers un dépôt PUBLIC.',
          '',
          `  git restore --staged "${chemin}"`,
        ],
      });
    }
  }
}

/* ------------------------------------------- 3. aucun fichier démesuré */

for (const chemin of stagés) {
  let taille = 0;
  try {
    taille = Number(git('cat-file', '-s', `${OBJET}${chemin}`));
  } catch {
    continue;
  }
  if (taille > TAILLE_MAX) {
    refus.push({
      titre: `fichier de ${(taille / 1024 / 1024).toFixed(1)} Mo dans l’index : ${chemin}`,
      details: [
        `Au-delà de ${TAILLE_MAX / 1024 / 1024} Mo, ce n'est pas du code.`,
        "Un export de compte SW pèse ~9,5 Mo et n'a rien à faire dans le dépôt.",
        '',
        `  git restore --staged "${chemin}"`,
        '',
        'Si ce fichier est légitime, ce hook se contourne : `git commit --no-verify`.',
      ],
    });
  }
}

/* --------------------------------------------- 4. ESLint sur le code indexé */
//
// Les ERREURS seules (`--quiet`) : un avertissement ne bloque pas un commit.
// ESLint du dépôt (`node_modules`), avec sa configuration : absent (clone
// sans `npm install`), le lint est sauté avec un avertissement — le hook
// n'est jamais requis. Contrat : docs/03-developpeur/qualite-code.md.

const CODE = /\.(ts|tsx|js|mjs|cjs)$/;
const codeIndex = stagés.filter((c) => CODE.test(c));

if (!COMMIT && codeIndex.length > 0) {
  const racineDepot = git('rev-parse', '--show-toplevel');
  const eslint = join(racineDepot, 'node_modules', 'eslint', 'bin', 'eslint.js');
  if (!existsSync(join(racineDepot, 'eslint.config.js'))) {
    // Branche antérieure au lint : rien à appliquer.
  } else if (!existsSync(eslint)) {
    avertissements.push('ESLint absent (`npm install`) : lint du code indexé sauté.');
  } else {
    // Par paquets : une ligne de commande Windows plafonne à ~32 000 caractères.
    const sorties = [];
    for (let i = 0; i < codeIndex.length; i += 100) {
      try {
        execFileSync(process.execPath, [eslint, '--quiet', '--no-warn-ignored', ...codeIndex.slice(i, i + 100)], {
          cwd: racineDepot,
          encoding: 'utf8',
          stdio: ['ignore', 'pipe', 'pipe'],
          maxBuffer: 64 * 1024 * 1024,
        });
      } catch (e) {
        sorties.push(((e.stdout ?? '') + (e.stderr ?? '')).trim());
      }
    }
    if (sorties.length > 0) {
      refus.push({
        titre: 'ESLint refuse le code indexé',
        details: [
          ...sorties.join('\n').split('\n'),
          '',
          'Corriger, réindexer, puis recommiter. Détail sur tout le dépôt :',
          '  npm run lint',
        ],
      });
    }
  }
}

/* ------------------------------ 5. références à `src/` dans les tests indexés */
//
// La règle de la vérification `lecturesource`, la même (scripts/lib/
// lectureSource.ts), sur les seuls fichiers de `tests/` indexés, lus dans
// l'INDEX — pas l'arbre de travail : un `git add -p` partiel se juge sur ce
// qui part dans le commit. La liste comparée est la version indexée de
// `tests/fixtures/lecture-source-toleree.json`. Contrat :
// docs/03-developpeur/qualite-code.md, « Références à `src/` au commit ».
//
// Fichiers jugés : ceux de `tests/` ajoutés, modifiés, renommés ou supprimés
// (un renommage vaut suppression + ajout), et, si la liste est indexée, ceux
// dont elle change les entrées. Pour chacun, le relevé de l'index doit égaler
// ses entrées : un fichier supprimé n'en garde aucune.
//
// Jamais bloquant pour l'environnement : module ou `typescript` introuvable →
// avertissement, étape sautée. Fusion en cours (`MERGE_HEAD`) : sautée, son
// contenu vient de commits déjà passés par ici, et `npm test` juge l'état
// final. Sous `--commit` (CI) : non rejouée, comme ESLint — la CI lance ce
// rejeu avant `npm ci`, sans `typescript`, et vérifie l'état final par
// `npm test`.

const LISTE_LECTURE = 'tests/fixtures/lecture-source-toleree.json';

function fusionEnCours() {
  try {
    git('rev-parse', '-q', '--verify', 'MERGE_HEAD');
    return true;
  } catch {
    return false;
  }
}

/** Contenu d'un objet (`:<chemin>` index, `HEAD:<chemin>`), ou `null` s'il n'existe pas. */
function lireObjet(objet) {
  try {
    return execFileSync('git', ['cat-file', 'blob', objet], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      maxBuffer: 64 * 1024 * 1024,
    });
  } catch {
    return null;
  }
}

if (!COMMIT) {
  // `--no-renames` : un renommage arrive en `D` + `A`, ce qui suffit. Sans
  // chemin de `tests/` indexé, cet appel est tout le coût de l'étape.
  let changes = [];
  try {
    const t = git('diff', '--cached', '--name-status', '-z', '--no-renames', '--', 'tests').split('\0').filter(Boolean);
    for (let i = 0; i + 1 < t.length; i += 2) changes.push({ statut: t[i], chemin: t[i + 1] });
  } catch {
    changes = [];
  }
  changes = changes.filter((c) => c.chemin.startsWith('tests/'));

  if (changes.length > 0 && !fusionEnCours()) {
    const racineDepot = git('rev-parse', '--show-toplevel');
    const module = join(racineDepot, 'scripts', 'lib', 'lectureSource.ts');
    const listeIndex = lireObjet(`:${LISTE_LECTURE}`);
    if (!existsSync(module)) {
      // Sans liste non plus : branche antérieure à la garde, rien à appliquer.
      if (listeIndex !== null) {
        avertissements.push('module scripts/lib/lectureSource.ts introuvable : références à `src/` dans les tests non vérifiées.');
      }
    } else if (!existsSync(join(racineDepot, 'node_modules', 'typescript', 'package.json'))) {
      avertissements.push('TypeScript absent (`npm install`) : références à `src/` dans les tests non vérifiées.');
    } else {
      let regle = null;
      try {
        regle = await import(pathToFileURL(module).href);
      } catch (e) {
        avertissements.push(`module scripts/lib/lectureSource.ts non chargé (${String(e?.message ?? e).split('\n')[0]}) : ` +
          'références à `src/` dans les tests non vérifiées.');
      }
      if (regle) {
        const details = verifierLectures(regle, changes, listeIndex);
        if (details) refus.push({ titre: 'référence à `src/` non déclarée dans un test', details });
      }
    }
  }
}

/** Diagnostic du refus, ou `null` si l'index respecte la liste indexée. */
function verifierLectures(regle, changes, listeIndex) {
  const voir = [
    '',
    'La liste comparée est celle de l’INDEX : la réindexer avec le test.',
    'Détail : tests/README.md, « Garde des références à `src/` » ; tout tests/ :',
    '  node tests/run.mjs lecturesource',
  ];
  if (listeIndex === null) {
    return [`${LISTE_LECTURE} absente de l’index : la garde n’a rien à quoi comparer.`, ...voir];
  }
  const lireEntrees = (texte) => {
    const e = JSON.parse(texte).entrees;
    if (!Array.isArray(e)) throw new Error('clé `entrees` absente');
    if (e.some((x) => !x || typeof x !== 'object')) throw new Error('une entrée n’est pas un objet');
    return e;
  };
  let entrees;
  try {
    entrees = lireEntrees(listeIndex);
  } catch (e) {
    return [`${LISTE_LECTURE} indexée illisible : ${e.message}`, ...voir];
  }

  const juges = new Set(changes.map((c) => c.chemin).filter((c) => c !== LISTE_LECTURE));
  if (changes.some((c) => c.chemin === LISTE_LECTURE)) {
    // Liste indexée : tout fichier dont elle change les entrées est jugé aussi.
    let avant = [];
    try {
      const t = lireObjet(`HEAD:${LISTE_LECTURE}`);
      avant = t === null ? [] : lireEntrees(t);
    } catch {
      avant = [];
    }
    const parFichier = (liste) => {
      const m = new Map();
      for (const e of liste) m.set(e.fichier, [...(m.get(e.fichier) ?? []), JSON.stringify(e)]);
      for (const [f, v] of m) m.set(f, v.sort().join('\n'));
      return m;
    };
    const a = parFichier(avant);
    const b = parFichier(entrees);
    for (const f of new Set([...a.keys(), ...b.keys()])) if (a.get(f) !== b.get(f)) juges.add(f);
  }

  const supprimes = new Set(changes.filter((c) => c.statut === 'D').map((c) => c.chemin));
  const cibles = new Map();
  for (const f of juges) {
    if (supprimes.has(f) || !regle.EXTENSIONS.test(f)) continue;
    const texte = lireObjet(`:${f}`);
    if (texte === null) continue;
    const c = regle.releverCibles(f, texte);
    if (c.length > 0) cibles.set(f, c);
  }
  const { nonListes, perimees, invalides } = regle.comparer(
    regle.regrouper(cibles),
    entrees.filter((e) => juges.has(e.fichier)),
  );
  if (nonListes.length + perimees.length + invalides.length === 0) return null;

  const bloc = (titre, lignes) => (lignes.length === 0 ? [] : [titre, ...lignes.map((l) => `  ${l}`), '']);
  return [
    'Un test qui lit `src/` comme du texte n’importe pas le module : la sélection',
    'par fichiers modifiés ne le voit que si l’usage est déclaré dans la liste.',
    '',
    ...bloc('Non déclarée — fichier → cible (trouvé dans l’index, attendu par la liste) :', nonListes),
    ...bloc('Entrée qui ne correspond plus — fichier → cible (attendu, trouvé) :', perimees),
    ...bloc('Liste mal formée :', invalides),
    'Quoi faire :',
    '- mieux : retirer la lecture, et vérifier le comportement en important le',
    '  module (rendu serveur, valeur rendue) ;',
    `- sinon : une entrée { fichier, cible, occurrences } dans ${LISTE_LECTURE},`,
    '  statut `exception`, avec sa justification (jamais un `stock` de plus) ;',
    '- une lecture retirée, ou un fichier supprimé : retirer son entrée (ou',
    '  baisser `occurrences`) dans le même commit.',
    ...voir,
  ];
}

/* ------------------------------------------------------------- verdict */

for (const a of avertissements) {
  console.error(`${JAUNE}⚠️  ${a}${FIN}`);
}

if (refus.length === 0) process.exit(0);

console.error('');
for (const { titre, details } of refus) {
  console.error(`${ROUGE}REFUSÉ — ${titre}${FIN}`);
  for (const d of details) console.error(`  ${d}`);
  console.error('');
}
process.exit(1);
